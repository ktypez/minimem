# /etc/minimem/minimem.env — chmod 600, owned by the service user.
# Nothing secret ever lives in the repo.

MINIMEM_DB_PATH=/home/CHANGEME/minimem-data/minimem.db
MINIMEM_TOKEN=replace-me-with-64-random-chars
MINIMEM_LOCK=12345678

# 1 = require a token (default). 0 = open API; only ever behind loopback/VPN.
AUTH_ENABLED=1

HOST=127.0.0.1
PORT=3100

# /extract only
EXTRACT_MODELS=google/gemini-2.5-flash-lite
# AI_GATEWAY_API_KEY=...
