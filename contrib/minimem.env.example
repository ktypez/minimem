# /etc/minimem/minimem.env — chmod 600, owned by the service user.
# Nothing secret ever lives in the repo.

MINIMEM_DB_PATH=/home/CHANGEME/minimem-data/minimem.db
MINIMEM_TOKEN=replace-me-with-64-random-chars
MINIMEM_LOCK=12345678

# 1 = require a token (default). 0 = open API; only ever behind loopback/VPN.
AUTH_ENABLED=1

HOST=127.0.0.1
PORT=3100

# 1 = serve the MCP endpoint (default). 0 = REST only, agents lose their tools.
MINIMEM_MCP=1

# /extract only
EXTRACT_MODELS=google/gemini-2.5-flash-lite
# AI_GATEWAY_API_KEY=...

# ---------- semantic layer (optional) ----------
# Set a Cloudflare Workers AI token and the semantic index switches itself on.
# Without them minimem stays keyword-only (FTS5 trigram) and everything still works.
# CF_AI_TOKEN=
# CF_ACCOUNT_ID=
# EMBED_ENABLED=1
# EMBED_MODEL=@cf/baai/bge-m3
# EMBED_DIM=1024
# EMBED_PROVIDER=cloudflare
# EMBED_TIMEOUT_MS=20000

# ---------- ranking knobs ----------
# Defaults are measured values; change them only with a reason.
# HYBRID_W_FTS=1
# HYBRID_W_VEC=1
# HYBRID_W_REC=0.15
# SEM_MIN_RELEVANCE=0.5
# SEM_COS_NOISE_FLOOR=0.45
# SEM_COS_GOOD_CEIL=0.65
# SEM_FTS_STRONG=8
# SEM_HALF_LIFE_DAYS=45
# SEM_DEDUPE_THRESHOLD=0.76
# SUPERSEDE_MARGIN_HOURS=24
# TRUST_WEIGHT_VERIFIED=1.1
# TRUST_WEIGHT_UNVERIFIED=1.0
# TRUST_WEIGHT_DISPUTED=0.5
